{
  "imports": [],
  "mcpServers": {
    "atlassian": {
      "command": "npx",
      "args": ["-y", "mcp-remote@0.1.38", "https://mcp.atlassian.com/v1/mcp/authv2", "--transport", "http-only"],
      "lifecycle": "lazy"
    },
    "computer-use": {
      "disabled": true
    },
    "slack": {
      "command": "python3",
      "args": ["__HOME__/.agents/skills/slack-mcp/scripts/slack-mcp-proxy.py"],
      "lifecycle": "lazy"
    },
    "trajectory": {
      "command": "__HOME__/.trajectory/bin/trajectory",
      "args": ["mcp"],
      "lifecycle": "eager"
    }
  }
}
