{
  "name": "pi-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Portable Pi cockpit with bounded memory, review tools, orchestration, and a lifecycle pet.",
  "repository": "github:ellataira/pi-workbench",
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "pi-action-inbox": "./bin/action-inbox.mjs",
    "pi-review-open": "./bin/pi-review-open.mjs"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build:pet": "./scripts/build-pet-app.sh",
    "canary:memory": "node bin/memory-canary.mjs",
    "audit:pi": "node bin/pi-health-audit.mjs",
    "install:daily-review": "./scripts/install-daily-review-reminder.sh",
    "install:pi-copy-picker": "node scripts/install-pi-copy-picker.mjs",
    "install:pi-prompt-echo": "node scripts/install-pi-prompt-echo.mjs",
    "migrate:memory": "node bin/migrate-memory.mjs --apply",
    "test": "node --test tests/*.test.mjs",
    "test:e2e-review": "node scripts/test-review-comments-e2e.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-agent-journal.ts",
      "./extensions/pi-cmux-supervisor.ts",
      "./extensions/pi-pair-terminal.ts",
      "./extensions/pi-lifecycle-pet.ts",
      "./extensions/pi-action-inbox.ts",
      "./extensions/pi-project-profiles.ts",
      "./extensions/pi-workspace-switch.ts",
      "./extensions/pi-review-surface.ts",
      "./extensions/pi-session-utilities.ts",
      "./extensions/pi-mcp-recovery.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "marked": "18.0.7"
  }
}
